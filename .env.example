NODE_ENV=development

# API
API_PORT=4000
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3000
ENABLE_SWAGGER=true
# Generate a unique value of at least 32 characters; never commit the real value.
IAM_ACCESS_TOKEN_SECRET=
# One-time administrator bootstrap inputs (used only by iam:bootstrap-admin).
IAM_BOOTSTRAP_ADMIN_USERNAME=
IAM_BOOTSTRAP_ADMIN_EMAIL=
IAM_BOOTSTRAP_ADMIN_PASSWORD=
IAM_BOOTSTRAP_ADMIN_NAME=

# PostgreSQL / Prisma (local-only example credentials)
POSTGRES_DB=rubi
POSTGRES_USER=rubi_local
POSTGRES_PASSWORD=rubi_local_dev
DATABASE_URL=postgresql://rubi_local:rubi_local_dev@localhost:5432/rubi?schema=public

# Redis / BullMQ (local-only example credentials)
REDIS_PASSWORD=rubi_local_dev
REDIS_URL=redis://:rubi_local_dev@localhost:6379
WORKER_QUEUE_NAME=rubi-system-health

# MinIO (local-only example credentials)
MINIO_ROOT_USER=rubi_local
MINIO_ROOT_PASSWORD=rubi_local_dev
MINIO_BUCKET=rubi-files
MINIO_ENDPOINT=http://localhost:9000
# Private encrypted Documents adapter; production object-storage adapter remains a separate deployment concern.
DOCUMENTS_STORAGE_ROOT=.data/documents
DOCUMENTS_STORAGE_ENCRYPTION_KEY_BASE64=
DOCUMENTS_ANTIVIRUS_MODE=disabled
DOCUMENTS_ANTIVIRUS_COMMAND=

# Web (public browser configuration; never place secrets in NEXT_PUBLIC_* values)
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
# Customer contact encryption (base64-encoded 32-byte keys; configure outside Git)
CUSTOMER_CONTACT_ENCRYPTION_KEY_BASE64=
CUSTOMER_CONTACT_FINGERPRINT_KEY_BASE64=
CUSTOMER_CONTACT_ENCRYPTION_KEY_VERSION=
# Independent base64 32-byte HMAC key for short-lived Master Data import preview tokens.
MASTER_DATA_IMPORT_TOKEN_KEY_BASE64=
