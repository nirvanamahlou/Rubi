{
  "name": "@nora/contracts",
  "version": "0.0.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./iam/session": {
      "types": "./dist/iam/session.d.ts",
      "default": "./dist/iam/session.js"
    },
    "./sales/pricing": {
      "types": "./dist/sales/pricing.d.ts",
      "default": "./dist/sales/pricing.js"
    },
    "./upload-formats": {
      "types": "./dist/upload-formats.d.ts",
      "default": "./dist/upload-formats.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "lint": "eslint src test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@nora/eslint-config": "workspace:*",
    "@nora/typescript-config": "workspace:*",
    "eslint": "9.39.5",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
