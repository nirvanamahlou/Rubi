model DocumentProcessingJob {
  id            String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  versionId     String                   @map("version_id") @db.Uuid
  jobType       String                   @map("job_type") @db.VarChar(80)
  status        DocumentProcessingStatus @default(PENDING)
  attempts      Int                      @default(0)
  availableAt   DateTime                 @default(now()) @map("available_at") @db.Timestamptz(3)
  lastErrorCode String?                  @map("last_error_code") @db.VarChar(120)
