enum CustomerKind {
  PERSON
  ORGANIZATION
}

enum CustomerContactType {
  PHONE
  EMAIL
}

enum CustomerAddressType {
  HOME
  WORK
  BILLING
  OTHER
}

enum CustomerConsentStatus {
  GRANTED
  REVOKED
}

enum CustomerConsentPurpose {
  MARKETING
}

enum CustomerConsentChannel {
  SMS
  EMAIL
  PHONE
  ALL
}

enum CustomerRelationshipType {
  FAMILY
  COMPANION
  GUARDIAN
  DEPENDENT
}

enum CustomerDuplicateReviewStatus {
  PENDING
  CONFIRMED_DISTINCT
  MERGE_PROPOSED
}

model Customer {
  id                   String                       @id @default(uuid()) @db.Uuid
  kind                 CustomerKind
  organizationId       String?                      @db.Uuid
  firstName            String?                      @db.VarChar(120)
  lastName             String?                      @db.VarChar(120)
  displayName          String                       @db.VarChar(200)
  birthDate            DateTime?                    @db.Date
  isActive             Boolean                      @default(true)
  isCustomer           Boolean                      @default(true)
  isPassenger          Boolean                      @default(false)
  acquaintanceMethodId String?                      @db.Uuid
  ownerBranchId        String                       @db.Uuid
  version              Int                          @default(1)
  mergedIntoId         String?                      @db.Uuid
  createdByUserId      String                       @db.Uuid
  updatedByUserId      String                       @db.Uuid
  deactivatedByUserId  String?                      @db.Uuid
  deactivatedAt        DateTime?                    @db.Timestamptz(3)
  createdAt            DateTime                     @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime                     @updatedAt @db.Timestamptz(3)
  organization         MasterOrganization?          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  acquaintanceMethod   MasterAcquaintanceMethod?    @relation(fields: [acquaintanceMethodId], references: [id], onDelete: Restrict)
  ownerBranch          Branch                       @relation("CustomerOwnerBranch", fields: [ownerBranchId], references: [id], onDelete: Restrict)
  createdBy            User                         @relation("CustomerCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedBy            User                         @relation("CustomerUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: Restrict)
  deactivatedBy        User?                        @relation("CustomerDeactivatedBy", fields: [deactivatedByUserId], references: [id], onDelete: Restrict)
  mergedInto           Customer?                    @relation("CustomerMergeTrace", fields: [mergedIntoId], references: [id], onDelete: Restrict)
  mergedCustomers      Customer[]                   @relation("CustomerMergeTrace")
  contacts             CustomerContact[]
  addresses            CustomerAddress[]
  consents             CustomerConsent[]
  relationships        CustomerRelationship[]       @relation("CustomerRelationshipFrom")
  relatedFrom          CustomerRelationship[]       @relation("CustomerRelationshipTo")
  duplicateCandidates  CustomerDuplicateCandidate[] @relation("DuplicateSourceCustomer")
  duplicateMatches     CustomerDuplicateCandidate[] @relation("DuplicateCandidateCustomer")
  statusHistory        CustomerStatusHistory[]

  @@index([ownerBranchId, isActive, updatedAt])
  @@index([displayName])
  @@index([organizationId])
  @@index([acquaintanceMethodId])
  @@map("customers")
}

model CustomerContact {
  id                   String              @id @default(uuid()) @db.Uuid
  customerId           String              @db.Uuid
  type                 CustomerContactType
  label                String?             @db.VarChar(80)
  maskedValue          String              @db.VarChar(160)
  encryptedValue       String?             @db.Text
  encryptionIv         String?             @db.Char(16)
  encryptionAuthTag    String?             @db.Char(24)
  encryptionKeyVersion Int?
  valueFingerprint     String?             @db.Char(64)
  valueHash            String              @db.Char(64)
  isPrimary            Boolean             @default(false)
  verifiedAt           DateTime?           @db.Timestamptz(3)
  createdByUserId      String              @db.Uuid
  createdAt            DateTime            @default(now()) @db.Timestamptz(3)
  customer             Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdBy            User                @relation("CustomerContactCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@unique([customerId, type, valueHash])
  @@unique([customerId, type, valueFingerprint])
  @@index([type, valueHash])
  @@index([type, valueFingerprint, customerId])
  @@index([customerId, isPrimary])
  @@map("customer_contacts")
}

model CustomerAddress {
  id              String              @id @default(uuid()) @db.Uuid
  customerId      String              @db.Uuid
  type            CustomerAddressType
  label           String              @db.VarChar(240)
  cityId          String?             @db.Uuid
  isPrimary       Boolean             @default(false)
  createdByUserId String              @db.Uuid
  createdAt       DateTime            @default(now()) @db.Timestamptz(3)
  customer        Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  city            MasterCity?         @relation(fields: [cityId], references: [id], onDelete: Restrict)
  createdBy       User                @relation("CustomerAddressCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([customerId, isPrimary])
  @@index([cityId])
  @@map("customer_addresses")
}

model CustomerConsent {
  id               String                 @id @default(uuid()) @db.Uuid
  customerId       String                 @db.Uuid
  purpose          CustomerConsentPurpose
  channel          CustomerConsentChannel
  status           CustomerConsentStatus
  source           String                 @db.VarChar(120)
  reason           String                 @db.VarChar(500)
  occurredAt       DateTime               @db.Timestamptz(3)
  recordedByUserId String                 @db.Uuid
  createdAt        DateTime               @default(now()) @db.Timestamptz(3)
  customer         Customer               @relation(fields: [customerId], references: [id], onDelete: Restrict)
  recordedBy       User                   @relation("CustomerConsentRecordedBy", fields: [recordedByUserId], references: [id], onDelete: Restrict)

  @@index([customerId, purpose, channel, occurredAt])
  @@map("customer_consents")
}

model CustomerRelationship {
  id                String                   @id @default(uuid()) @db.Uuid
  customerId        String                   @db.Uuid
  relatedCustomerId String                   @db.Uuid
  relationshipType  CustomerRelationshipType
  createdByUserId   String                   @db.Uuid
  createdAt         DateTime                 @default(now()) @db.Timestamptz(3)
  customer          Customer                 @relation("CustomerRelationshipFrom", fields: [customerId], references: [id], onDelete: Restrict)
  relatedCustomer   Customer                 @relation("CustomerRelationshipTo", fields: [relatedCustomerId], references: [id], onDelete: Restrict)
  createdBy         User                     @relation("CustomerRelationshipCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@unique([customerId, relatedCustomerId, relationshipType])
  @@index([relatedCustomerId])
  @@map("customer_relationships")
}

model CustomerStatusHistory {
  id              String   @id @default(uuid()) @db.Uuid
  customerId      String   @db.Uuid
  fromStatus      String   @db.VarChar(32)
  toStatus        String   @db.VarChar(32)
  reason          String   @db.VarChar(500)
  changedByUserId String   @db.Uuid
  actorBranchId   String   @db.Uuid
  changedAt       DateTime @default(now()) @db.Timestamptz(3)
  customer        Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  changedBy       User     @relation("CustomerStatusChangedBy", fields: [changedByUserId], references: [id], onDelete: Restrict)
  actorBranch     Branch   @relation(fields: [actorBranchId], references: [id], onDelete: Restrict)

  @@index([customerId, changedAt])
  @@map("customer_status_history")
}

model CustomerDuplicateCandidate {
  id                  String                        @id @default(uuid()) @db.Uuid
  sourceCustomerId    String                        @db.Uuid
  candidateCustomerId String                        @db.Uuid
  score               Int
  reasons             String[]
  reviewStatus        CustomerDuplicateReviewStatus @default(PENDING)
  reviewReason        String?                       @db.VarChar(500)
  version             Int                           @default(1)
  createdByUserId     String                        @db.Uuid
  reviewedByUserId    String?                       @db.Uuid
  reviewedAt          DateTime?                     @db.Timestamptz(3)
  createdAt           DateTime                      @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime                      @updatedAt @db.Timestamptz(3)
  sourceCustomer      Customer                      @relation("DuplicateSourceCustomer", fields: [sourceCustomerId], references: [id], onDelete: Restrict)
  candidateCustomer   Customer                      @relation("DuplicateCandidateCustomer", fields: [candidateCustomerId], references: [id], onDelete: Restrict)
  createdBy           User                          @relation("CustomerDuplicateCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  reviewedBy          User?                         @relation("CustomerDuplicateReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: Restrict)

  @@unique([sourceCustomerId, candidateCustomerId])
  @@index([reviewStatus, createdAt])
  @@map("customer_duplicate_candidates")
}

model CustomerAuditEvent {
  id             String       @id @default(uuid()) @db.Uuid
  actorUserId    String       @db.Uuid
  actorBranchId  String       @db.Uuid
  action         String       @db.VarChar(120)
  entityType     String       @db.VarChar(80)
  entityId       String?      @db.Uuid
  outcome        AuditOutcome
  reason         String?      @db.VarChar(500)
  beforeSnapshot Json?
  afterSnapshot  Json?
  traceId        String?      @db.VarChar(120)
  occurredAt     DateTime     @default(now()) @db.Timestamptz(3)
  actor          User         @relation("CustomerAuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  actorBranch    Branch       @relation(fields: [actorBranchId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId, occurredAt])
  @@index([actorUserId, occurredAt])
  @@map("customer_audit_events")
}

enum LegalEntityContextMode {
  SPECIFIC
  ALL
}

enum LegalEntityDocumentIssueStatus {
  ISSUED
  FAILED
}

model LegalEntity {
  id                      String                       @id @default(uuid()) @db.Uuid
  code                    String                       @unique @db.VarChar(40)
  persianName             String                       @db.VarChar(200)
  latinName               String?                      @db.VarChar(200)
  tradeName               String?                      @db.VarChar(200)
  logoFileId              String?                      @db.Uuid
  letterheadFileId        String?                      @db.Uuid
  footerFileId            String?                      @db.Uuid
  address                 String?                      @db.VarChar(500)
  phone                   String?                      @db.VarChar(80)
  email                   String?                      @db.VarChar(320)
  website                 String?                      @db.VarChar(320)
  nationalId              String?                      @db.VarChar(80)
  registrationNumber      String?                      @db.VarChar(80)
  economicCode            String?                      @db.VarChar(80)
  paymentText             String?                      @db.VarChar(1000)
  sealFileId              String?                      @db.Uuid
  authorizedSignatureId   String?                      @db.Uuid
  primaryColor            String?                      @db.VarChar(16)
  secondaryColor          String?                      @db.VarChar(16)
  legalFooterText         String?                      @db.VarChar(1000)
  isActive                Boolean                      @default(true)
  version                 Int                          @default(1)
  brandingSnapshotVersion Int                          @default(1)
  updatedByUserId         String?                      @db.Uuid
  deactivatedAt           DateTime?                    @db.Timestamptz(3)
  createdAt               DateTime                     @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime                     @updatedAt @db.Timestamptz(3)
  updatedBy               User?                        @relation("LegalEntityUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  contexts                UserLegalEntityContext[]
  brandingVersions        LegalEntityBrandingVersion[]
  auditEvents             LegalEntityAuditEvent[]
  documentIssues          LegalEntityDocumentIssue[]

  @@index([isActive, persianName])
  @@map("legal_entities")
}

model UserLegalEntityContext {
  userId        String                 @id @db.Uuid
  mode          LegalEntityContextMode @default(SPECIFIC)
  legalEntityId String?                @db.Uuid
  version       Int                    @default(1)
  updatedAt     DateTime               @updatedAt @db.Timestamptz(3)
  user          User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  legalEntity   LegalEntity?           @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)

  @@index([legalEntityId])
  @@map("user_legal_entity_contexts")
}

model LegalEntityBrandingVersion {
  id              String      @id @default(uuid()) @db.Uuid
  legalEntityId   String      @db.Uuid
  version         Int
  snapshot        Json
  createdByUserId String      @db.Uuid
  createdAt       DateTime    @default(now()) @db.Timestamptz(3)
  legalEntity     LegalEntity @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
  createdBy       User        @relation("LegalEntityBrandingVersionCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  documentIssues LegalEntityDocumentIssue[] @relation("LegalEntityDocumentIssueBranding")

  @@unique([legalEntityId, version])
  @@unique([id, legalEntityId, version])
  @@index([legalEntityId, createdAt])
  @@map("legal_entity_branding_versions")
}

model LegalEntityAuditEvent {
  id             String       @id @default(uuid()) @db.Uuid
  actorUserId    String       @db.Uuid
  action         String       @db.VarChar(120)
  entityId       String?      @db.Uuid
  outcome        AuditOutcome
  reason         String?      @db.VarChar(500)
  beforeSnapshot Json?
  afterSnapshot  Json?
  occurredAt     DateTime     @default(now()) @db.Timestamptz(3)
  actor          User         @relation("LegalEntityAuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  entity         LegalEntity? @relation(fields: [entityId], references: [id], onDelete: Restrict)

  @@index([entityId, occurredAt])
  @@index([actorUserId, occurredAt])
  @@map("legal_entity_audit_events")
}

model LegalEntityDocumentIssue {
  id                      String                         @id @default(uuid()) @db.Uuid
  issuerLegalEntityId     String                         @db.Uuid
  issuerCode              String                         @db.VarChar(40)
  issuerName              String                         @db.VarChar(200)
  brandingSnapshotId      String                         @db.Uuid
  brandingSnapshotVersion Int
  brandingSnapshot        Json
  templateId              String                         @db.VarChar(120)
  templateVersion         String                         @db.VarChar(80)
  templatePolicyId        String                         @db.VarChar(120)
  templatePolicyVersion   String                         @db.VarChar(80)
  actorUserId             String                         @db.Uuid
  issuedAt                DateTime                       @default(now()) @db.Timestamptz(3)
  documentType            String                         @db.VarChar(120)
  referenceEntityType     String                         @db.VarChar(120)
  referenceEntityId       String                         @db.VarChar(160)
  fileHash                String?                        @db.Char(64)
  status                  LegalEntityDocumentIssueStatus
  reissueReason           String?                        @db.VarChar(500)
  originalIssueId         String?                        @db.Uuid
  issuer                  LegalEntity                    @relation(fields: [issuerLegalEntityId], references: [id], onDelete: Restrict)
  brandingVersion         LegalEntityBrandingVersion     @relation("LegalEntityDocumentIssueBranding", fields: [brandingSnapshotId, issuerLegalEntityId, brandingSnapshotVersion], references: [id, legalEntityId, version], onDelete: Restrict, onUpdate: Restrict)
  actor                   User                           @relation("LegalEntityDocumentIssueActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  originalIssue           LegalEntityDocumentIssue?      @relation("LegalEntityReissues", fields: [originalIssueId], references: [id], onDelete: Restrict)
  reissues                LegalEntityDocumentIssue[]     @relation("LegalEntityReissues")

  @@index([issuerLegalEntityId, issuedAt])
  @@index([referenceEntityType, referenceEntityId, issuedAt])
  @@index([actorUserId, issuedAt])
  @@map("legal_entity_document_issues")
}
