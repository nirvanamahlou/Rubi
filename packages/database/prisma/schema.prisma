generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "cjs"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
  engineType             = "client"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
}

enum SessionStatus {
  ACTIVE
  ROTATED
  REVOKED
  EXPIRED
}

enum AuditOutcome {
  SUCCESS
  FAILURE
}

model User {
  id                           String                       @id @default(uuid()) @db.Uuid
  username                     String                       @unique @db.VarChar(80)
  email                        String?                      @unique @db.VarChar(320)
  displayName                  String                       @db.VarChar(160)
  passwordHash                 String                       @db.VarChar(255)
  status                       UserStatus                   @default(ACTIVE)
  failedLoginAttempts          Int                          @default(0)
  lockedUntil                  DateTime?                    @db.Timestamptz(3)
  passwordChangedAt            DateTime                     @default(now()) @db.Timestamptz(3)
  lastLoginAt                  DateTime?                    @db.Timestamptz(3)
  createdAt                    DateTime                     @default(now()) @db.Timestamptz(3)
  updatedAt                    DateTime                     @updatedAt @db.Timestamptz(3)
  roles                        UserRole[]
  branches                     UserBranch[]
  sessions                     Session[]
  auditEvents                  AuditEvent[]                 @relation("AuditActor")
  customersCreated             Customer[]                   @relation("CustomerCreatedBy")
  customersUpdated             Customer[]                   @relation("CustomerUpdatedBy")
  customersDeactivated         Customer[]                   @relation("CustomerDeactivatedBy")
  customerContactsCreated      CustomerContact[]            @relation("CustomerContactCreatedBy")
  customerAddressesCreated     CustomerAddress[]            @relation("CustomerAddressCreatedBy")
  customerConsentsRecorded     CustomerConsent[]            @relation("CustomerConsentRecordedBy")
  customerRelationshipsCreated CustomerRelationship[]       @relation("CustomerRelationshipCreatedBy")
  customerStatusChanges        CustomerStatusHistory[]      @relation("CustomerStatusChangedBy")
  customerDuplicateCandidates  CustomerDuplicateCandidate[] @relation("CustomerDuplicateCreatedBy")
  customerDuplicateReviews     CustomerDuplicateCandidate[] @relation("CustomerDuplicateReviewedBy")
  customerAuditEvents          CustomerAuditEvent[]         @relation("CustomerAuditActor")
  legalEntityContext           UserLegalEntityContext?
  legalEntitiesUpdated         LegalEntity[]                @relation("LegalEntityUpdatedBy")
  legalEntityBrandingVersions  LegalEntityBrandingVersion[] @relation("LegalEntityBrandingVersionCreatedBy")
  legalEntityAuditEvents       LegalEntityAuditEvent[]      @relation("LegalEntityAuditActor")
  legalEntityDocumentIssues    LegalEntityDocumentIssue[]   @relation("LegalEntityDocumentIssueActor")

  @@map("iam_users")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique @db.VarChar(80)
  name        String           @db.VarChar(120)
  description String?          @db.VarChar(500)
  isSystem    Boolean          @default(false)
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)
  users       UserRole[]
  permissions RolePermission[]

  @@map("iam_roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique @db.VarChar(120)
  module      String           @db.VarChar(80)
  name        String           @db.VarChar(160)
  description String?          @db.VarChar(500)
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  roles       RolePermission[]

  @@map("iam_permissions")
}

model UserRole {
  userId     String   @db.Uuid
  roleId     String   @db.Uuid
  assignedAt DateTime @default(now()) @db.Timestamptz(3)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("iam_user_roles")
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  grantedAt    DateTime   @default(now()) @db.Timestamptz(3)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("iam_role_permissions")
}

model Branch {
  id                    String                  @id @default(uuid()) @db.Uuid
  code                  String                  @unique @db.VarChar(40)
  name                  String                  @db.VarChar(160)
  isActive              Boolean                 @default(true)
  createdAt             DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime                @updatedAt @db.Timestamptz(3)
  users                 UserBranch[]
  ownedCustomers        Customer[]              @relation("CustomerOwnerBranch")
  customerStatusHistory CustomerStatusHistory[]
  customerAuditEvents   CustomerAuditEvent[]

  @@map("branches")
}

model UserBranch {
  userId    String   @db.Uuid
  branchId  String   @db.Uuid
  isPrimary Boolean  @default(false)
  grantedAt DateTime @default(now()) @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@id([userId, branchId])
  @@index([branchId])
  @@map("iam_user_branches")
}

model Session {
  id               String        @id @default(uuid()) @db.Uuid
  userId           String        @db.Uuid
  familyId         String        @db.Uuid
  refreshTokenHash String        @db.Char(64)
  status           SessionStatus @default(ACTIVE)
  expiresAt        DateTime      @db.Timestamptz(3)
  lastUsedAt       DateTime      @default(now()) @db.Timestamptz(3)
  revokedAt        DateTime?     @db.Timestamptz(3)
  revokedReason    String?       @db.VarChar(160)
  ipAddress        String?       @db.VarChar(64)
  userAgent        String?       @db.VarChar(500)
  createdAt        DateTime      @default(now()) @db.Timestamptz(3)
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([familyId])
  @@index([expiresAt])
  @@map("iam_sessions")
}

model AuditEvent {
  id          String       @id @default(uuid()) @db.Uuid
  actorUserId String?      @db.Uuid
  action      String       @db.VarChar(120)
  entityType  String       @db.VarChar(80)
  entityId    String?      @db.VarChar(160)
  outcome     AuditOutcome
  metadata    Json?
  ipAddress   String?      @db.VarChar(64)
  userAgent   String?      @db.VarChar(500)
  occurredAt  DateTime     @default(now()) @db.Timestamptz(3)
  actor       User?        @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, occurredAt])
  @@index([action, occurredAt])
  @@map("iam_audit_events")
}

enum MasterOrganizationRoleCode {
  AGENCY
  CORPORATE_CUSTOMER
  SUPPLIER
  AIRLINE
  HOTEL_PROVIDER
  INSURANCE_PROVIDER
  BUS_PROVIDER
  TOUR_OPERATOR
  BROKER
}

enum MasterCurrencyRateType {
  BUY
  SELL
  REFERENCE
}

enum MasterCurrencyRateStatus {
  DRAFT
  APPROVED
  REJECTED
  EXPIRED
}

enum MasterHotelImportStatus {
  PREVIEW_READY
  COMMITTING
  COMPLETED
  FAILED
  EXPIRED
}

enum MasterHotelImportDuplicateBehavior {
  SKIP
  UPDATE
  CREATE_NEW
}

enum MasterDataExportFormat {
  XLSX
  PDF
}

enum MasterDataExportStatus {
  AWAITING_DOCUMENTS_WORKER
  PROCESSING
  COMPLETED
  FAILED
}

enum MasterRegionType {
  PROVINCE
  STATE
  REGION
  TERRITORY
}

enum MasterTerminalType {
  DOMESTIC
  INTERNATIONAL
  VIP
}

model MasterCountry {
  id                  String                     @id @default(uuid()) @db.Uuid
  code                String                     @unique @db.Char(2)
  name                String                     @db.VarChar(160)
  englishName         String                     @db.VarChar(160)
  isActive            Boolean                    @default(true)
  version             Int                        @default(1)
  createdByUserId     String                     @db.Uuid
  updatedByUserId     String                     @db.Uuid
  deactivatedByUserId String?                    @db.Uuid
  deactivatedAt       DateTime?                  @db.Timestamptz(3)
  createdAt           DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime                   @updatedAt @db.Timestamptz(3)
  cities              MasterCity[]
  regions             MasterRegion[]
  banks               MasterBank[]
  hotelImports        MasterHotelImportSession[]

  @@index([isActive, name])
  @@map("master_countries")
}

model MasterCity {
  id                        String                     @id @default(uuid()) @db.Uuid
  countryId                 String                     @db.Uuid
  regionId                  String?                    @db.Uuid
  code                      String                     @db.VarChar(32)
  name                      String                     @db.VarChar(160)
  englishName               String                     @db.VarChar(160)
  isActive                  Boolean                    @default(true)
  version                   Int                        @default(1)
  createdByUserId           String                     @db.Uuid
  updatedByUserId           String                     @db.Uuid
  deactivatedByUserId       String?                    @db.Uuid
  deactivatedAt             DateTime?                  @db.Timestamptz(3)
  createdAt                 DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt                 DateTime                   @updatedAt @db.Timestamptz(3)
  country                   MasterCountry              @relation(fields: [countryId], references: [id], onDelete: Restrict)
  region                    MasterRegion?              @relation(fields: [regionId, countryId], references: [id, countryId], onDelete: Restrict)
  hotels                    MasterHotel[]
  airports                  MasterAirport[]
  customerAddresses         CustomerAddress[]
  masterHotelImportSessions MasterHotelImportSession[]

  @@unique([countryId, code])
  @@index([countryId, isActive, name])
  @@index([regionId, isActive, name])
  @@map("master_cities")
}

model MasterRegion {
  id                  String           @id @default(uuid()) @db.Uuid
  countryId           String           @db.Uuid
  parentRegionId      String?          @db.Uuid
  code                String           @db.VarChar(32)
  name                String           @db.VarChar(160)
  englishName         String           @db.VarChar(160)
  type                MasterRegionType
  isActive            Boolean          @default(true)
  version             Int              @default(1)
  createdByUserId     String           @db.Uuid
  updatedByUserId     String           @db.Uuid
  deactivatedByUserId String?          @db.Uuid
  deactivatedAt       DateTime?        @db.Timestamptz(3)
  createdAt           DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime         @updatedAt @db.Timestamptz(3)
  country             MasterCountry    @relation(fields: [countryId], references: [id], onDelete: Restrict)
  parent              MasterRegion?    @relation("MasterRegionHierarchy", fields: [parentRegionId, countryId], references: [id, countryId], onDelete: Restrict)
  children            MasterRegion[]   @relation("MasterRegionHierarchy")
  cities              MasterCity[]

  @@unique([countryId, code])
  @@unique([id, countryId])
  @@index([countryId, type, isActive, name])
  @@index([parentRegionId, isActive, name])
  @@map("master_regions")
}

model MasterAirport {
  id                  String           @id @default(uuid()) @db.Uuid
  cityId              String           @db.Uuid
  iataCode            String           @unique @db.Char(3)
  icaoCode            String           @unique @db.Char(4)
  name                String           @db.VarChar(160)
  englishName         String           @db.VarChar(160)
  ianaTimezone        String           @db.VarChar(80)
  latitude            Decimal          @db.Decimal(9, 6)
  longitude           Decimal          @db.Decimal(9, 6)
  isActive            Boolean          @default(true)
  version             Int              @default(1)
  createdByUserId     String           @db.Uuid
  updatedByUserId     String           @db.Uuid
  deactivatedByUserId String?          @db.Uuid
  deactivatedAt       DateTime?        @db.Timestamptz(3)
  createdAt           DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime         @updatedAt @db.Timestamptz(3)
  city                MasterCity       @relation(fields: [cityId], references: [id], onDelete: Restrict)
  terminals           MasterTerminal[]

  @@index([cityId, isActive, name])
  @@index([ianaTimezone, isActive])
  @@map("master_airports")
}

model MasterTerminal {
  id                  String             @id @default(uuid()) @db.Uuid
  airportId           String             @db.Uuid
  code                String             @db.VarChar(32)
  name                String             @db.VarChar(160)
  englishName         String?            @db.VarChar(160)
  terminalType        MasterTerminalType
  isActive            Boolean            @default(true)
  version             Int                @default(1)
  createdByUserId     String             @db.Uuid
  updatedByUserId     String             @db.Uuid
  deactivatedByUserId String?            @db.Uuid
  deactivatedAt       DateTime?          @db.Timestamptz(3)
  createdAt           DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime           @updatedAt @db.Timestamptz(3)
  airport             MasterAirport      @relation(fields: [airportId], references: [id], onDelete: Restrict)

  @@unique([airportId, code])
  @@index([airportId, terminalType, isActive, name])
  @@map("master_terminals")
}

model MasterCurrency {
  id                  String                    @id @default(uuid()) @db.Uuid
  code                String                    @unique @db.Char(3)
  name                String                    @db.VarChar(160)
  englishName         String?                   @db.VarChar(160)
  symbol              String?                   @db.VarChar(16)
  decimalDigits       Int                       @default(2)
  isActive            Boolean                   @default(true)
  version             Int                       @default(1)
  createdByUserId     String                    @db.Uuid
  updatedByUserId     String                    @db.Uuid
  deactivatedByUserId String?                   @db.Uuid
  deactivatedAt       DateTime?                 @db.Timestamptz(3)
  createdAt           DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime                  @updatedAt @db.Timestamptz(3)
  draftRatesFrom      MasterDraftExchangeRate[] @relation("DraftRateFromCurrency")
  draftRatesTo        MasterDraftExchangeRate[] @relation("DraftRateToCurrency")

  @@index([isActive, name])
  @@map("master_currencies")
}

model MasterDraftExchangeRate {
  id                  String                   @id @default(uuid()) @db.Uuid
  fromCurrencyId      String                   @db.Uuid
  toCurrencyId        String                   @db.Uuid
  rate                Decimal                  @db.Decimal(24, 10)
  rateType            MasterCurrencyRateType   @default(REFERENCE)
  source              String                   @db.VarChar(160)
  observedAt          DateTime                 @db.Timestamptz(3)
  validFrom           DateTime                 @db.Timestamptz(3)
  validTo             DateTime?                @db.Timestamptz(3)
  status              MasterCurrencyRateStatus @default(DRAFT)
  correctionReason    String?                  @db.VarChar(500)
  decisionReason      String?                  @db.VarChar(500)
  approvedByUserId    String?                  @db.Uuid
  approvedAt          DateTime?                @db.Timestamptz(3)
  isAuthoritative     Boolean                  @default(false)
  isActive            Boolean                  @default(true)
  version             Int                      @default(1)
  createdByUserId     String                   @db.Uuid
  updatedByUserId     String                   @db.Uuid
  deactivatedByUserId String?                  @db.Uuid
  deactivatedAt       DateTime?                @db.Timestamptz(3)
  createdAt           DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime                 @updatedAt @db.Timestamptz(3)
  fromCurrency        MasterCurrency           @relation("DraftRateFromCurrency", fields: [fromCurrencyId], references: [id], onDelete: Restrict)
  toCurrency          MasterCurrency           @relation("DraftRateToCurrency", fields: [toCurrencyId], references: [id], onDelete: Restrict)

  @@index([fromCurrencyId, toCurrencyId, rateType, status, validFrom])
  @@index([fromCurrencyId, toCurrencyId, observedAt])
  @@index([isActive, observedAt])
  @@map("master_draft_exchange_rates")
}

model MasterBank {
  id                  String        @id @default(uuid()) @db.Uuid
  countryId           String        @db.Uuid
  code                String        @unique @db.VarChar(32)
  name                String        @db.VarChar(160)
  isActive            Boolean       @default(true)
  version             Int           @default(1)
  createdByUserId     String        @db.Uuid
  updatedByUserId     String        @db.Uuid
  deactivatedByUserId String?       @db.Uuid
  deactivatedAt       DateTime?     @db.Timestamptz(3)
  createdAt           DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime      @updatedAt @db.Timestamptz(3)
  country             MasterCountry @relation(fields: [countryId], references: [id], onDelete: Restrict)

  @@index([countryId, isActive, name])
  @@map("master_banks")
}

model MasterOrganization {
  id                  String                   @id @default(uuid()) @db.Uuid
  code                String                   @unique @db.VarChar(32)
  legalName           String                   @db.VarChar(200)
  displayName         String                   @db.VarChar(160)
  isActive            Boolean                  @default(true)
  version             Int                      @default(1)
  createdByUserId     String                   @db.Uuid
  updatedByUserId     String                   @db.Uuid
  deactivatedByUserId String?                  @db.Uuid
  deactivatedAt       DateTime?                @db.Timestamptz(3)
  createdAt           DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime                 @updatedAt @db.Timestamptz(3)
  roles               MasterOrganizationRole[]
  insurer             MasterInsurer?
  airline             MasterAirline?
  broker              MasterBroker?
  hotel               MasterHotel?
  customers           Customer[]

  @@index([isActive, displayName])
  @@map("master_organizations")
}

model MasterOrganizationRole {
  organizationId   String                     @db.Uuid
  roleCode         MasterOrganizationRoleCode
  assignedAt       DateTime                   @default(now()) @db.Timestamptz(3)
  assignedByUserId String                     @db.Uuid
  organization     MasterOrganization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@id([organizationId, roleCode])
  @@index([roleCode])
  @@map("master_organization_roles")
}

model MasterInsurer {
  id                  String             @id @default(uuid()) @db.Uuid
  organizationId      String             @unique @db.Uuid
  code                String             @unique @db.VarChar(32)
  name                String             @db.VarChar(160)
  isActive            Boolean            @default(true)
  version             Int                @default(1)
  createdByUserId     String             @db.Uuid
  updatedByUserId     String             @db.Uuid
  deactivatedByUserId String?            @db.Uuid
  deactivatedAt       DateTime?          @db.Timestamptz(3)
  createdAt           DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime           @updatedAt @db.Timestamptz(3)
  organization        MasterOrganization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([isActive, name])
  @@map("master_insurers")
}

model MasterAirline {
  id                  String             @id @default(uuid()) @db.Uuid
  organizationId      String             @unique @db.Uuid
  code                String             @unique @db.Char(2)
  icaoCode            String?            @unique @db.Char(3)
  name                String             @db.VarChar(160)
  isActive            Boolean            @default(true)
  version             Int                @default(1)
  createdByUserId     String             @db.Uuid
  updatedByUserId     String             @db.Uuid
  deactivatedByUserId String?            @db.Uuid
  deactivatedAt       DateTime?          @db.Timestamptz(3)
  createdAt           DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime           @updatedAt @db.Timestamptz(3)
  organization        MasterOrganization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([isActive, name])
  @@map("master_airlines")
}

model MasterHotel {
  id                  String                @id @default(uuid()) @db.Uuid
  cityId              String                @db.Uuid
  organizationId      String?               @unique @db.Uuid
  mealServiceId       String?               @db.Uuid
  defaultRoomTypeId   String?               @db.Uuid
  code                String                @unique @db.VarChar(32)
  name                String                @db.VarChar(160)
  englishName         String?               @db.VarChar(160)
  address             String?               @db.VarChar(1000)
  description         String?               @db.VarChar(2000)
  hotelRules          String?               @db.VarChar(2000)
  starRating          Int?
  isSaleableReference Boolean               @default(true)
  isActive            Boolean               @default(true)
  version             Int                   @default(1)
  createdByUserId     String                @db.Uuid
  updatedByUserId     String                @db.Uuid
  deactivatedByUserId String?               @db.Uuid
  deactivatedAt       DateTime?             @db.Timestamptz(3)
  createdAt           DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime              @updatedAt @db.Timestamptz(3)
  city                MasterCity            @relation(fields: [cityId], references: [id], onDelete: Restrict)
  organization        MasterOrganization?   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  mealService         MasterMealService?    @relation(fields: [mealServiceId], references: [id], onDelete: Restrict)
  defaultRoomType     MasterRoomType?       @relation(fields: [defaultRoomTypeId], references: [id], onDelete: Restrict)
  facilities          MasterHotelFacility[]

  @@index([cityId, isActive, name])
  @@index([mealServiceId])
  @@index([defaultRoomTypeId])
  @@map("master_hotels")
}

model MasterMealService {
  id                  String        @id @default(uuid()) @db.Uuid
  code                String        @unique @db.VarChar(32)
  name                String        @db.VarChar(160)
  englishName         String?       @db.VarChar(160)
  includedMeals       String[]
  isActive            Boolean       @default(true)
  version             Int           @default(1)
  createdByUserId     String        @db.Uuid
  updatedByUserId     String        @db.Uuid
  deactivatedByUserId String?       @db.Uuid
  deactivatedAt       DateTime?     @db.Timestamptz(3)
  createdAt           DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime      @updatedAt @db.Timestamptz(3)
  hotels              MasterHotel[]

  @@index([isActive, name])
  @@map("master_meal_services")
}

model MasterRoomType {
  id                  String        @id @default(uuid()) @db.Uuid
  code                String        @unique @db.VarChar(32)
  name                String        @db.VarChar(160)
  englishName         String?       @db.VarChar(160)
  referenceCapacity   Int?
  isActive            Boolean       @default(true)
  version             Int           @default(1)
  createdByUserId     String        @db.Uuid
  updatedByUserId     String        @db.Uuid
  deactivatedByUserId String?       @db.Uuid
  deactivatedAt       DateTime?     @db.Timestamptz(3)
  createdAt           DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime      @updatedAt @db.Timestamptz(3)
  hotels              MasterHotel[]

  @@index([isActive, name])
  @@map("master_room_types")
}

model MasterFacility {
  id                  String                @id @default(uuid()) @db.Uuid
  code                String                @unique @db.VarChar(32)
  name                String                @db.VarChar(160)
  englishName         String?               @db.VarChar(160)
  category            String?               @db.VarChar(80)
  iconFileReference   String?               @db.Uuid
  isActive            Boolean               @default(true)
  version             Int                   @default(1)
  createdByUserId     String                @db.Uuid
  updatedByUserId     String                @db.Uuid
  deactivatedByUserId String?               @db.Uuid
  deactivatedAt       DateTime?             @db.Timestamptz(3)
  createdAt           DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime              @updatedAt @db.Timestamptz(3)
  hotels              MasterHotelFacility[]

  @@index([isActive, name])
  @@map("master_facilities")
}

model MasterHotelFacility {
  hotelId          String         @db.Uuid
  facilityId       String         @db.Uuid
  assignedAt       DateTime       @default(now()) @db.Timestamptz(3)
  assignedByUserId String         @db.Uuid
  hotel            MasterHotel    @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  facility         MasterFacility @relation(fields: [facilityId], references: [id], onDelete: Restrict)

  @@id([hotelId, facilityId])
  @@index([facilityId])
  @@map("master_hotel_facilities")
}

model MasterHotelImportSession {
  id                 String                              @id @default(uuid()) @db.Uuid
  templateVersion    String                              @db.VarChar(40)
  fileHash           String                              @db.Char(64)
  originalFileName   String                              @db.VarChar(255)
  stagingFileName    String                              @unique @db.VarChar(100)
  actorUserId        String                              @db.Uuid
  actorBranchId      String                              @db.Uuid
  countryId          String                              @db.Uuid
  cityId             String                              @db.Uuid
  previewTokenHash   String                              @unique @db.Char(64)
  previewExpiresAt   DateTime                            @db.Timestamptz(3)
  idempotencyKeyHash String?                             @unique @db.Char(64)
  status             MasterHotelImportStatus             @default(PREVIEW_READY)
  duplicateBehavior  MasterHotelImportDuplicateBehavior?
  mappingSnapshot    Json
  malwareScanStatus  String                              @db.VarChar(40)
  rowCount           Int                                 @default(0)
  validCount         Int                                 @default(0)
  invalidCount       Int                                 @default(0)
  duplicateCount     Int                                 @default(0)
  createdCount       Int                                 @default(0)
  updatedCount       Int                                 @default(0)
  skippedCount       Int                                 @default(0)
  errorReport        Json?
  traceId            String?                             @db.VarChar(120)
  committedAt        DateTime?                           @db.Timestamptz(3)
  createdAt          DateTime                            @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime                            @updatedAt @db.Timestamptz(3)
  country            MasterCountry                       @relation(fields: [countryId], references: [id], onDelete: Restrict)
  city               MasterCity                          @relation(fields: [cityId], references: [id], onDelete: Restrict)

  @@index([actorUserId, createdAt])
  @@index([status, previewExpiresAt])
  @@index([fileHash, templateVersion, countryId, cityId])
  @@map("master_hotel_import_sessions")
}

