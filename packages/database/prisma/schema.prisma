generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "cjs"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
  engineType             = "client"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
}

enum SessionStatus {
  ACTIVE
  ROTATED
  REVOKED
  EXPIRED
}

enum AuditOutcome {
  SUCCESS
  FAILURE
}

model User {
  id                           String                       @id @default(uuid()) @db.Uuid
  username                     String                       @unique @db.VarChar(80)
  email                        String?                      @unique @db.VarChar(320)
  displayName                  String                       @db.VarChar(160)
  passwordHash                 String                       @db.VarChar(255)
  status                       UserStatus                   @default(ACTIVE)
  failedLoginAttempts          Int                          @default(0)
  lockedUntil                  DateTime?                    @db.Timestamptz(3)
  passwordChangedAt            DateTime                     @default(now()) @db.Timestamptz(3)
  lastLoginAt                  DateTime?                    @db.Timestamptz(3)
  createdAt                    DateTime                     @default(now()) @db.Timestamptz(3)
  updatedAt                    DateTime                     @updatedAt @db.Timestamptz(3)
  roles                        UserRole[]
  branches                     UserBranch[]
  sessions                     Session[]
  auditEvents                  AuditEvent[]                 @relation("AuditActor")
  customersCreated             Customer[]                   @relation("CustomerCreatedBy")
  customersUpdated             Customer[]                   @relation("CustomerUpdatedBy")
  customersDeactivated         Customer[]                   @relation("CustomerDeactivatedBy")
  customerContactsCreated      CustomerContact[]            @relation("CustomerContactCreatedBy")
  customerAddressesCreated     CustomerAddress[]            @relation("CustomerAddressCreatedBy")
  customerConsentsRecorded     CustomerConsent[]            @relation("CustomerConsentRecordedBy")
  customerRelationshipsCreated CustomerRelationship[]       @relation("CustomerRelationshipCreatedBy")
  customerStatusChanges        CustomerStatusHistory[]      @relation("CustomerStatusChangedBy")
  customerDuplicateCandidates  CustomerDuplicateCandidate[] @relation("CustomerDuplicateCreatedBy")
  customerDuplicateReviews     CustomerDuplicateCandidate[] @relation("CustomerDuplicateReviewedBy")
  customerAuditEvents          CustomerAuditEvent[]         @relation("CustomerAuditActor")
  legalEntityContext           UserLegalEntityContext?
  legalEntitiesUpdated         LegalEntity[]                @relation("LegalEntityUpdatedBy")
  legalEntityBrandingVersions  LegalEntityBrandingVersion[] @relation("LegalEntityBrandingVersionCreatedBy")
  legalEntityAuditEvents       LegalEntityAuditEvent[]      @relation("LegalEntityAuditActor")
  legalEntityDocumentIssues    LegalEntityDocumentIssue[]   @relation("LegalEntityDocumentIssueActor")
  documentsOwned               Document[]                   @relation("DocumentOwner")
  documentsCreated             Document[]                   @relation("DocumentCreatedBy")
  documentsUpdated             Document[]                   @relation("DocumentUpdatedBy")
  documentVersionsCreated      DocumentVersion[]            @relation("DocumentVersionCreatedBy")
  documentAuditEvents          DocumentAuditEvent[]         @relation("DocumentAuditActor")
  documentQuarantinesReviewed  DocumentQuarantine[]         @relation("DocumentQuarantineReviewer")

  @@map("iam_users")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique @db.VarChar(80)
  name        String           @db.VarChar(120)
  description String?          @db.VarChar(500)
  isSystem    Boolean          @default(false)
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)
  users       UserRole[]
  permissions RolePermission[]

  @@map("iam_roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique @db.VarChar(120)
  module      String           @db.VarChar(80)
  name        String           @db.VarChar(160)
  description String?          @db.VarChar(500)
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  roles       RolePermission[]

  @@map("iam_permissions")
}

model UserRole {
  userId     String   @db.Uuid
  roleId     String   @db.Uuid
  assignedAt DateTime @default(now()) @db.Timestamptz(3)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("iam_user_roles")
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  grantedAt    DateTime   @default(now()) @db.Timestamptz(3)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("iam_role_permissions")
}

model Branch {
  id                    String                  @id @default(uuid()) @db.Uuid
  code                  String                  @unique @db.VarChar(40)
  name                  String                  @db.VarChar(160)
  isActive              Boolean                 @default(true)
  createdAt             DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime                @updatedAt @db.Timestamptz(3)
  users                 UserBranch[]
  ownedCustomers        Customer[]              @relation("CustomerOwnerBranch")
  customerStatusHistory CustomerStatusHistory[]
  customerAuditEvents   CustomerAuditEvent[]
  documents             Document[]
  documentAuditEvents   DocumentAuditEvent[]

  @@map("branches")
}

model UserBranch {
  userId    String   @db.Uuid
  branchId  String   @db.Uuid
  isPrimary Boolean  @default(false)
  grantedAt DateTime @default(now()) @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@id([userId, branchId])
  @@index([branchId])
  @@map("iam_user_branches")
}

model Session {
  id               String        @id @default(uuid()) @db.Uuid
  userId           String        @db.Uuid
  familyId         String        @db.Uuid
  refreshTokenHash String        @db.Char(64)
  status           SessionStatus @default(ACTIVE)
  expiresAt        DateTime      @db.Timestamptz(3)
  lastUsedAt       DateTime      @default(now()) @db.Timestamptz(3)
  revokedAt        DateTime?     @db.Timestamptz(3)
  revokedReason    String?       @db.VarChar(160)
  ipAddress        String?       @db.VarChar(64)
  userAgent        String?       @db.VarChar(500)
  createdAt        DateTime      @default(now()) @db.Timestamptz(3)
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([familyId])
  @@index([expiresAt])
  @@map("iam_sessions")
}

model AuditEvent {
  id          String       @id @default(uuid()) @db.Uuid
  actorUserId String?      @db.Uuid
  action      String       @db.VarChar(120)
  entityType  String       @db.VarChar(80)
  entityId    String?      @db.VarChar(160)
  outcome     AuditOutcome
  metadata    Json?
  ipAddress   String?      @db.VarChar(64)
  userAgent   String?      @db.VarChar(500)
  occurredAt  DateTime     @default(now()) @db.Timestamptz(3)
  actor       User?        @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, occurredAt])
  @@index([action, occurredAt])
  @@map("iam_audit_events")
}

enum MasterOrganizationRoleCode {
  AGENCY
  CORPORATE_CUSTOMER
  SUPPLIER
  AIRLINE
  HOTEL_PROVIDER
  INSURANCE_PROVIDER
  BUS_PROVIDER
  RAIL_OPERATOR
  TOUR_OPERATOR
  BROKER
}

enum MasterCurrencyRateType {
  BUY
  SELL
  REFERENCE
}

enum MasterCurrencyRateStatus {
  DRAFT
  APPROVED
  REJECTED
  EXPIRED
}

enum MasterCurrencyDisplayPolicy {
  SYMBOL_BEFORE
  SYMBOL_AFTER
  CODE_BEFORE
  CODE_AFTER
}

enum MasterPaymentMethodChannel {
  CASH
  POS
  BANK_TRANSFER
  ONLINE_GATEWAY
  CREDIT
  WALLET
  OTHER
}

enum MasterPaymentMethodDirection {
  RECEIPT
  PAYMENT
  BOTH
}

enum MasterHotelImportStatus {
  PREVIEW_READY
  COMMITTING
  COMPLETED
  FAILED
  EXPIRED
}

enum MasterHotelImportDuplicateBehavior {
  SKIP
  UPDATE
  CREATE_NEW
}

enum MasterMealServiceCategory {
  MEAL_PLAN
  SERVICE
}

enum MasterAircraftBodyType {
  NARROW_BODY
  WIDE_BODY
  TURBOPROP
  REGIONAL
  OTHER
}

enum MasterCabinType {
  ECONOMY
  PREMIUM_ECONOMY
  BUSINESS
  FIRST
}

enum MasterPassengerType {
  ADT
  CHD
  INF
}

enum MasterBaggageUnit {
  KG
  PC
}

enum MasterTransportRouteScope {
  ALL
  DOMESTIC
  INTERNATIONAL
}

enum MasterManifestFileFormat {
  XLSX
  CSV
  XML
  JSON
}

enum MasterManifestTemplateStatus {
  DRAFT
  ACTIVE
  EXPIRED
}

enum MasterTrainCategory {
  SLEEPER
  EXPRESS
  SALOON
  LUXURY
  OTHER
}

enum MasterBusServiceClass {
  STANDARD
  VIP
  LUXURY
  OTHER
}

enum MasterTourScope {
  DOMESTIC
  INTERNATIONAL
  BOTH
}

enum MasterTransferServiceMode {
  PRIVATE
  SHARED
}

enum MasterCipPassengerScope {
  ADT
  CHD
  INF
  ALL
}

enum MasterDataExportFormat {
  XLSX
  PDF
}

enum MasterDataExportStatus {
  AWAITING_DOCUMENTS_WORKER
  PROCESSING
  COMPLETED
  FAILED
}

enum MasterRegionType {
  PROVINCE
  STATE
  REGION
  TERRITORY
}

enum MasterTerminalType {
  DOMESTIC
  INTERNATIONAL
  MIXED
  VIP
}

enum MasterCollaborationStatus {
  ACTIVE
  UNDER_REVIEW
  PURCHASE_SUSPENDED
  ENDED
}

enum MasterOrganizationContactChannel {
  PHONE
  WHATSAPP
  EMAIL
  TELEGRAM
  OTHER
}

model MasterCountry {
  id                  String                     @id @default(uuid()) @db.Uuid
  code                String                     @unique @db.Char(2)
  name                String                     @db.VarChar(160)
  englishName         String                     @db.VarChar(160)
  displayOrder        Int                        @default(0)
  isActive            Boolean                    @default(true)
  version             Int                        @default(1)
  createdByUserId     String                     @db.Uuid
  updatedByUserId     String                     @db.Uuid
  deactivatedByUserId String?                    @db.Uuid
  deactivatedAt       DateTime?                  @db.Timestamptz(3)
  createdAt           DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime                   @updatedAt @db.Timestamptz(3)
  cities              MasterCity[]
  regions             MasterRegion[]
  banks               MasterBank[]
  suppliers           MasterSupplier[]
  brokers             MasterBroker[]
  hotelChains         MasterHotelChain[]
  hotelImports        MasterHotelImportSession[]
  airlines            MasterAirline[]
  railCompanies       MasterRailCompany[]
  busCompanies        MasterBusCompany[]
  insurers            MasterInsurer[]
  visaServices        MasterVisaService[]

  @@index([isActive, name])
  @@map("master_countries")
}

model MasterCity {
  id                        String                     @id @default(uuid()) @db.Uuid
  countryId                 String                     @db.Uuid
  regionId                  String?                    @db.Uuid
  code                      String                     @db.VarChar(32)
  name                      String                     @db.VarChar(160)
  englishName               String                     @db.VarChar(160)
  displayOrder              Int                        @default(0)
  isActive                  Boolean                    @default(true)
  version                   Int                        @default(1)
  createdByUserId           String                     @db.Uuid
  updatedByUserId           String                     @db.Uuid
  deactivatedByUserId       String?                    @db.Uuid
  deactivatedAt             DateTime?                  @db.Timestamptz(3)
  createdAt                 DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt                 DateTime                   @updatedAt @db.Timestamptz(3)
  country                   MasterCountry              @relation(fields: [countryId], references: [id], onDelete: Restrict)
  region                    MasterRegion?              @relation(fields: [regionId, countryId], references: [id, countryId], onDelete: Restrict)
  hotels                    MasterHotel[]
  airports                  MasterAirport[]
  bankBranches              MasterBankBranch[]
  suppliers                 MasterSupplier[]
  brokers                   MasterBroker[]
  compositeHotels           MasterCompositeHotel[]
  customerAddresses         CustomerAddress[]
  masterHotelImportSessions MasterHotelImportSession[]
  leaders                   MasterLeader[]

  @@unique([countryId, code])
  @@index([countryId, isActive, name])
  @@index([regionId, isActive, name])
  @@map("master_cities")
}

model MasterRegion {
  id                  String           @id @default(uuid()) @db.Uuid
  countryId           String           @db.Uuid
  parentRegionId      String?          @db.Uuid
  code                String           @db.VarChar(32)
  name                String           @db.VarChar(160)
  englishName         String           @db.VarChar(160)
  type                MasterRegionType @default(PROVINCE)
  displayOrder        Int              @default(0)
  isActive            Boolean          @default(true)
  version             Int              @default(1)
  createdByUserId     String           @db.Uuid
  updatedByUserId     String           @db.Uuid
  deactivatedByUserId String?          @db.Uuid
  deactivatedAt       DateTime?        @db.Timestamptz(3)
  createdAt           DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime         @updatedAt @db.Timestamptz(3)
  country             MasterCountry    @relation(fields: [countryId], references: [id], onDelete: Restrict)
  parent              MasterRegion?    @relation("MasterRegionHierarchy", fields: [parentRegionId, countryId], references: [id, countryId], onDelete: Restrict)
  children            MasterRegion[]   @relation("MasterRegionHierarchy")
  cities              MasterCity[]

  @@unique([countryId, code])
  @@unique([id, countryId])
  @@index([countryId, type, isActive, name])
  @@index([parentRegionId, isActive, name])
  @@map("master_regions")
}

model MasterAirport {
  id                  String             @id @default(uuid()) @db.Uuid
  cityId              String             @db.Uuid
  iataCode            String             @unique @db.Char(3)
  icaoCode            String             @unique @db.Char(4)
  name                String             @db.VarChar(160)
  englishName         String             @db.VarChar(160)
  ianaTimezone        String             @db.VarChar(80)
  latitude            Decimal            @db.Decimal(9, 6)
  longitude           Decimal            @db.Decimal(9, 6)
  displayOrder        Int                @default(0)
  isActive            Boolean            @default(true)
  version             Int                @default(1)
  createdByUserId     String             @db.Uuid
  updatedByUserId     String             @db.Uuid
  deactivatedByUserId String?            @db.Uuid
  deactivatedAt       DateTime?          @db.Timestamptz(3)
  createdAt           DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime           @updatedAt @db.Timestamptz(3)
  city                MasterCity         @relation(fields: [cityId], references: [id], onDelete: Restrict)
  terminals           MasterTerminal[]
  cipServices         MasterCipService[]

  @@index([cityId, isActive, name])
  @@index([ianaTimezone, isActive])
  @@map("master_airports")
}

model MasterTerminal {
  id                  String             @id @default(uuid()) @db.Uuid
  airportId           String             @db.Uuid
  code                String             @db.VarChar(32)
  name                String             @db.VarChar(160)
  englishName         String?            @db.VarChar(160)
  terminalType        MasterTerminalType
  gateCount           Int?
  operatingHoursMode  String?            @db.VarChar(16)
  opensAt             String?            @db.Char(5)
  closesAt            String?            @db.Char(5)
  displayOrder        Int                @default(0)
  isUnderMaintenance  Boolean            @default(false)
  isActive            Boolean            @default(true)
  version             Int                @default(1)
  createdByUserId     String             @db.Uuid
  updatedByUserId     String             @db.Uuid
  deactivatedByUserId String?            @db.Uuid
  deactivatedAt       DateTime?          @db.Timestamptz(3)
  createdAt           DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime           @updatedAt @db.Timestamptz(3)
  airport             MasterAirport      @relation(fields: [airportId], references: [id], onDelete: Restrict)

  @@unique([airportId, code])
  @@index([airportId, terminalType, isActive, name])
  @@map("master_terminals")
}

model MasterCurrency {
  id                  String                      @id @default(uuid()) @db.Uuid
  code                String                      @unique @db.Char(3)
  name                String                      @db.VarChar(160)
  englishName         String?                     @db.VarChar(160)
  symbol              String?                     @db.VarChar(16)
  decimalDigits       Int                         @default(2)
  displayPolicy       MasterCurrencyDisplayPolicy @default(CODE_AFTER)
  displayOrder        Int                         @default(0)
  isActive            Boolean                     @default(true)
  version             Int                         @default(1)
  createdByUserId     String                      @db.Uuid
  updatedByUserId     String                      @db.Uuid
  deactivatedByUserId String?                     @db.Uuid
  deactivatedAt       DateTime?                   @db.Timestamptz(3)
  createdAt           DateTime                    @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime                    @updatedAt @db.Timestamptz(3)
  draftRatesFrom      MasterDraftExchangeRate[]   @relation("DraftRateFromCurrency")
  draftRatesTo        MasterDraftExchangeRate[]   @relation("DraftRateToCurrency")
  insuranceCoverages  MasterInsuranceCoverage[]

  @@index([isActive, name])
  @@map("master_currencies")
}

model MasterDraftExchangeRate {
  id                  String                   @id @default(uuid()) @db.Uuid
  fromCurrencyId      String                   @db.Uuid
  toCurrencyId        String                   @db.Uuid
  rate                Decimal                  @db.Decimal(24, 10)
  rateType            MasterCurrencyRateType   @default(REFERENCE)
  source              String                   @db.VarChar(160)
  observedAt          DateTime                 @db.Timestamptz(3)
  validFrom           DateTime                 @db.Timestamptz(3)
  validTo             DateTime?                @db.Timestamptz(3)
  status              MasterCurrencyRateStatus @default(DRAFT)
  correctionReason    String?                  @db.VarChar(500)
  decisionReason      String?                  @db.VarChar(500)
  approvedByUserId    String?                  @db.Uuid
  approvedAt          DateTime?                @db.Timestamptz(3)
  isAuthoritative     Boolean                  @default(false)
  isActive            Boolean                  @default(true)
  version             Int                      @default(1)
  createdByUserId     String                   @db.Uuid
  updatedByUserId     String                   @db.Uuid
  deactivatedByUserId String?                  @db.Uuid
  deactivatedAt       DateTime?                @db.Timestamptz(3)
  createdAt           DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime                 @updatedAt @db.Timestamptz(3)
  fromCurrency        MasterCurrency           @relation("DraftRateFromCurrency", fields: [fromCurrencyId], references: [id], onDelete: Restrict)
  toCurrency          MasterCurrency           @relation("DraftRateToCurrency", fields: [toCurrencyId], references: [id], onDelete: Restrict)

  @@index([fromCurrencyId, toCurrencyId, rateType, status, validFrom])
  @@index([fromCurrencyId, toCurrencyId, observedAt])
  @@index([isActive, observedAt])
  @@map("master_draft_exchange_rates")
}

model MasterBank {
  id                  String             @id @default(uuid()) @db.Uuid
  countryId           String             @db.Uuid
  code                String             @unique @db.VarChar(32)
  name                String             @db.VarChar(160)
  englishName         String?            @db.VarChar(160)
  swiftCode           String?            @unique @db.VarChar(11)
  logoFileReference   String?            @db.Uuid
  displayOrder        Int                @default(0)
  isActive            Boolean            @default(true)
  version             Int                @default(1)
  createdByUserId     String             @db.Uuid
  updatedByUserId     String             @db.Uuid
  deactivatedByUserId String?            @db.Uuid
  deactivatedAt       DateTime?          @db.Timestamptz(3)
  createdAt           DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime           @updatedAt @db.Timestamptz(3)
  country             MasterCountry      @relation(fields: [countryId], references: [id], onDelete: Restrict)
  branches            MasterBankBranch[]

  @@index([countryId, isActive, name])
  @@map("master_banks")
}

model MasterBankBranch {
  id                  String     @id @default(uuid()) @db.Uuid
  bankId              String     @db.Uuid
  cityId              String     @db.Uuid
  code                String     @db.VarChar(32)
  name                String     @db.VarChar(160)
  englishName         String?    @db.VarChar(160)
  address             String?    @db.VarChar(500)
  phone               String?    @db.VarChar(32)
  displayOrder        Int        @default(0)
  isActive            Boolean    @default(true)
  version             Int        @default(1)
  createdByUserId     String     @db.Uuid
  updatedByUserId     String     @db.Uuid
  deactivatedByUserId String?    @db.Uuid
  deactivatedAt       DateTime?  @db.Timestamptz(3)
  createdAt           DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime   @updatedAt @db.Timestamptz(3)
  bank                MasterBank @relation(fields: [bankId], references: [id], onDelete: Restrict)
  city                MasterCity @relation(fields: [cityId], references: [id], onDelete: Restrict)

  @@unique([bankId, code])
  @@index([bankId, isActive, name])
  @@index([cityId, isActive, name])
  @@map("master_bank_branches")
}

model MasterPaymentMethod {
  id                     String                       @id @default(uuid()) @db.Uuid
  code                   String                       @unique @db.VarChar(32)
  name                   String                       @db.VarChar(160)
  englishName            String?                      @db.VarChar(160)
  description            String?                      @db.VarChar(500)
  channel                MasterPaymentMethodChannel
  direction              MasterPaymentMethodDirection @default(BOTH)
  requiresManualApproval Boolean                      @default(false)
  displayOrder           Int                          @default(0)
  isActive               Boolean                      @default(true)
  version                Int                          @default(1)
  createdByUserId        String                       @db.Uuid
  updatedByUserId        String                       @db.Uuid
  deactivatedByUserId    String?                      @db.Uuid
  deactivatedAt          DateTime?                    @db.Timestamptz(3)
  createdAt              DateTime                     @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime                     @updatedAt @db.Timestamptz(3)

  @@index([isActive, displayOrder, name])
  @@index([channel, direction, isActive])
  @@map("master_payment_methods")
}

model MasterOrganization {
  id                  String                      @id @default(uuid()) @db.Uuid
  code                String                      @unique @db.VarChar(32)
  legalName           String                      @db.VarChar(200)
  displayName         String                      @db.VarChar(160)
  personType          String?                     @db.VarChar(16)
  logoFileReference   String?                     @db.Uuid
  displayOrder        Int                         @default(0)
  isActive            Boolean                     @default(true)
  version             Int                         @default(1)
  createdByUserId     String                      @db.Uuid
  updatedByUserId     String                      @db.Uuid
  deactivatedByUserId String?                     @db.Uuid
  deactivatedAt       DateTime?                   @db.Timestamptz(3)
  createdAt           DateTime                    @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime                    @updatedAt @db.Timestamptz(3)
  roles               MasterOrganizationRole[]
  supplier            MasterSupplier?
  contacts            MasterOrganizationContact[]
  insurer             MasterInsurer?
  airline             MasterAirline?
  railCompany         MasterRailCompany?
  busCompany          MasterBusCompany?
  broker              MasterBroker?
  hotel               MasterHotel?
  customers           Customer[]

  @@index([isActive, displayName])
  @@map("master_organizations")
}

model MasterOrganizationRole {
  organizationId   String                     @db.Uuid
  roleCode         MasterOrganizationRoleCode
  assignedAt       DateTime                   @default(now()) @db.Timestamptz(3)
  assignedByUserId String                     @db.Uuid
  organization     MasterOrganization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@id([organizationId, roleCode])
  @@index([roleCode])
  @@map("master_organization_roles")
}

model MasterSupplier {
  id                        String                     @id @default(uuid()) @db.Uuid
  organizationId            String?                    @unique @db.Uuid
  countryId                 String?                    @db.Uuid
  cityId                    String?                    @db.Uuid
  code                      String                     @unique @db.VarChar(32)
  name                      String?                    @db.VarChar(160)
  englishName               String?                    @db.VarChar(160)
  logoFileReference         String?                    @db.Uuid
  displayOrder              Int                        @default(0)
  primaryContactId          String?                    @db.Uuid
  externalProviderReference String?                    @db.VarChar(120)
  collaborationStatus       MasterCollaborationStatus  @default(ACTIVE)
  isActive                  Boolean                    @default(true)
  version                   Int                        @default(1)
  createdByUserId           String                     @db.Uuid
  updatedByUserId           String                     @db.Uuid
