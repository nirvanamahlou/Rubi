generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "cjs"
  generatedFileExtension = "ts"
  importFileExtension    = "ts"
  engineType             = "client"
}

datasource db {
  provider = "postgresql"
}

// Business models are intentionally absent during Technical Bootstrap.
