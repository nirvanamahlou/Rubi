[Unit]
Description=Pull finalized Issabel recordings into encrypted ERP storage
After=network-online.target docker.service rubi-issabel-vpn.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -I /opt/rubi/private/call-recordings-1031/recording-pull.py
UMask=0077
LimitCORE=0
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
TimeoutStartSec=900
