[Unit]
Description=On-demand Issabel recording download gateway
After=network-online.target rubi-issabel-vpn.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 -I /opt/rubi/private/call-recordings-1031/recording-bridge.py
RuntimeDirectory=rubi-issabel-recordings
RuntimeDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=5
LimitCORE=0
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run/rubi-issabel-recordings

[Install]
WantedBy=multi-user.target
